<% layout('layouts/boilerplate') %>

<div class="auth-page-wrap">
    <div class="auth-card reveal-up">
        <div class="auth-card-header">
            <div class="auth-card-icon"><i class="fas fa-user-plus"></i></div>
            <h2>Create account</h2>
            <p>Join thousands of outdoor explorers</p>
        </div>

        <div class="auth-card-body">
            <form action="/register" method="POST" novalidate class="validated-form">

                <div class="field-group">
                    <label class="field-label" for="username">
                        <i class="fas fa-user"></i> Username
                    </label>
                    <input class="field-input" type="text" id="username" name="username"
                        placeholder="Choose a username" required autocomplete="username"
                        minlength="3" maxlength="30">
                    <div class="invalid-feedback">Please choose a username (3–30 chars).</div>
                </div>

                <div class="field-group">
                    <label class="field-label" for="email">
                        <i class="fas fa-envelope"></i> Email
                    </label>
                    <input class="field-input" type="email" id="email" name="email"
                        placeholder="you@example.com" required autocomplete="email">
                    <div class="invalid-feedback">Please enter a valid email address.</div>
                </div>

                <div class="field-group">
                    <label class="field-label" for="password">
                        <i class="fas fa-lock"></i> Password
                    </label>
                    <div class="field-addon-wrap">
                        <input class="field-input" type="password" id="password" name="password"
                            placeholder="Min 6 characters" required autocomplete="new-password" minlength="6">
                        <button type="button" class="field-addon-btn" id="togglePwd" title="Show/hide password">
                            <i class="fas fa-eye" id="pwdEyeIcon"></i>
                        </button>
                    </div>
                    <div class="invalid-feedback">Password must be at least 6 characters.</div>
                </div>

                <!-- Strength bar (shown after typing) -->
                <div id="strengthWrap" style="display:none;margin-top:-.6rem;margin-bottom:1rem">
                    <div style="height:4px;border-radius:2px;background:var(--border);overflow:hidden">
                        <div id="strengthBar" style="height:100%;width:0;border-radius:2px;transition:width .3s,background .3s"></div>
                    </div>
                    <div id="strengthLabel" style="font-size:.72rem;margin-top:.25rem;color:var(--text-muted)"></div>
                </div>

                <button type="submit" class="btn-fill"
                    style="width:100%;justify-content:center;padding:.75rem;margin-top:.25rem">
                    <i class="fas fa-user-plus"></i> Create Account
                </button>
            </form>

            <div class="auth-divider">or continue with</div>

            <a href="/auth/google" class="btn-google">
                <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
                    <path d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.875 2.684-6.615z" fill="#4285F4"/>
                    <path d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.258c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z" fill="#34A853"/>
                    <path d="M3.964 10.707A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.707V4.961H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.039l3.007-2.332z" fill="#FBBC05"/>
                    <path d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.961L3.964 7.293C4.672 5.163 6.656 3.58 9 3.58z" fill="#EA4335"/>
                </svg>
                Sign up with Google
            </a>

            <div class="auth-footer">
                Already have an account?
                <a href="/login">Sign in &rarr;</a>
            </div>
        </div>
    </div>
</div>

<script>
// Show / hide password
const togglePwd = document.getElementById('togglePwd');
const pwdInput  = document.getElementById('password');
const eyeIcon   = document.getElementById('pwdEyeIcon');
if (togglePwd) {
    togglePwd.addEventListener('click', () => {
        const show = pwdInput.type === 'password';
        pwdInput.type = show ? 'text' : 'password';
        eyeIcon.className = show ? 'fas fa-eye-slash' : 'fas fa-eye';
    });
}

// Password strength
const strengthWrap  = document.getElementById('strengthWrap');
const strengthBar   = document.getElementById('strengthBar');
const strengthLabel = document.getElementById('strengthLabel');
const levels = [
    { label:'Too short',  color:'#ef4444', w:'15%'  },
    { label:'Weak',       color:'#f97316', w:'35%'  },
    { label:'Fair',       color:'#eab308', w:'60%'  },
    { label:'Good',       color:'#22c55e', w:'80%'  },
    { label:'Strong',     color:'#16a34a', w:'100%' },
];
if (pwdInput) {
    pwdInput.addEventListener('input', () => {
        const v = pwdInput.value;
        if (!v) { strengthWrap.style.display = 'none'; return; }
        strengthWrap.style.display = 'block';
        let score = 0;
        if (v.length >= 6)  score++;
        if (v.length >= 10) score++;
        if (/[A-Z]/.test(v) && /[a-z]/.test(v)) score++;
        if (/[0-9]/.test(v)) score++;
        if (/[^A-Za-z0-9]/.test(v)) score++;
        const lvl = Math.min(score, levels.length - 1);
        strengthBar.style.width      = levels[lvl].w;
        strengthBar.style.background = levels[lvl].color;
        strengthLabel.textContent    = levels[lvl].label;
        strengthLabel.style.color    = levels[lvl].color;
    });
}
</script>
