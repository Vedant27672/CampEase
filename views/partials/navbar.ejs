<header class="site-nav" id="siteNav">
    <div class="nav-inner">

        <!-- Brand -->
        <a class="nav-brand" href="/">
            <span class="nav-brand-icon">⛺</span>
            <span class="nav-brand-text">CampEase</span>
        </a>

        <!-- Desktop links (centre) -->
        <nav class="nav-links" aria-label="Main navigation">
            <a class="nav-lnk" href="/">Home</a>
            <a class="nav-lnk" href="/campgrounds">Explore</a>
            <% if(currentUser) { %>
            <a class="nav-lnk nav-lnk-add" href="/campgrounds/new">
                <i class="fas fa-plus-circle"></i> New Camp
            </a>
            <% } %>
        </nav>

        <!-- Right actions -->
        <div class="nav-actions">
            <!-- Theme toggle -->
            <button class="theme-toggle" id="themeToggle" aria-label="Toggle colour theme" title="Toggle dark mode">
                <span class="t-sun"><i class="fas fa-sun"></i></span>
                <span class="t-moon"><i class="fas fa-moon"></i></span>
            </button>

            <% if(!currentUser) { %>
            <a class="btn-nav-ghost" href="/login">Sign in</a>
            <a class="btn-nav-fill" href="/register">Get started</a>
            <% } else { %>
            <!-- Cart icon -->
            <a href="/cart" class="nav-cart-btn" aria-label="Cart" title="My Cart">
                <i class="fas fa-shopping-cart"></i>
                <% if(cartCount > 0) { %><span class="cart-badge"><%= cartCount %></span><% } %>
            </a>
            <!-- User menu -->
            <div class="nav-user" id="navUser">
                <button class="nav-user-btn" id="navUserBtn" aria-expanded="false" aria-haspopup="true">
                    <span class="nav-avatar"><%= currentUser.username.charAt(0).toUpperCase() %></span>
                    <span class="nav-username"><%= currentUser.username %></span>
                    <i class="fas fa-chevron-down nav-chevron"></i>
                </button>
                <div class="nav-dropdown" id="navDropdown" role="menu">
                    <a class="nav-dd-item" href="/campgrounds/new" role="menuitem">
                        <i class="fas fa-plus-circle"></i> New Campground
                    </a>
                    <a class="nav-dd-item" href="/campgrounds" role="menuitem">
                        <i class="fas fa-campground"></i> All Campgrounds
                    </a>
                    <a class="nav-dd-item" href="/bookings" role="menuitem">
                        <i class="fas fa-calendar-check"></i> My Bookings
                    </a>
                    <a class="nav-dd-item" href="/bookings/calendar" role="menuitem">
                        <i class="fas fa-calendar-alt"></i> Booking Calendar
                    </a>
                    <a class="nav-dd-item" href="/cart" role="menuitem">
                        <i class="fas fa-shopping-cart"></i> My Cart
                        <% if(cartCount > 0) { %><span class="cart-badge ms-auto"><%= cartCount %></span><% } %>
                    </a>
                    <div class="nav-dd-divider"></div>
                    <a class="nav-dd-item nav-dd-danger" href="/logout" role="menuitem">
                        <i class="fas fa-sign-out-alt"></i> Sign out
                    </a>
                </div>
            </div>
            <% } %>

            <!-- Mobile hamburger -->
            <button class="nav-burger" id="navBurger" aria-label="Toggle menu" aria-expanded="false">
                <i class="fas fa-bars"></i>
            </button>
        </div>
    </div>

    <!-- Mobile drawer -->
    <div class="nav-mobile" id="navMobile" aria-hidden="true">
        <a class="nav-mob-lnk" href="/">Home</a>
        <a class="nav-mob-lnk" href="/campgrounds">Explore</a>
        <% if(currentUser) { %>
        <a class="nav-mob-lnk" href="/campgrounds/new">New Campground</a>
        <a class="nav-mob-lnk" href="/bookings"><i class="fas fa-calendar-check me-2"></i>My Bookings</a>
        <a class="nav-mob-lnk" href="/bookings/calendar"><i class="fas fa-calendar-alt me-2"></i>Booking Calendar</a>
        <a class="nav-mob-lnk" href="/cart"><i class="fas fa-shopping-cart me-2"></i>My Cart<% if(cartCount > 0) { %> <span class="cart-badge ms-1"><%= cartCount %></span><% } %></a>
        <hr class="nav-mob-hr">
        <a class="nav-mob-lnk" href="/logout">Sign out</a>
        <% } else { %>
        <hr class="nav-mob-hr">
        <a class="nav-mob-lnk" href="/login">Sign in</a>
        <a class="nav-mob-lnk nav-mob-fill" href="/register">Get started</a>
        <% } %>
    </div>
</header>
