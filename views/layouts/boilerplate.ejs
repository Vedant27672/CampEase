<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CampEase — Discover Amazing Campgrounds</title>

    <!-- Bootstrap 5.3 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Outfit (headings) + Inter (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <!-- Stars + Custom -->
    <link rel="stylesheet" href="/stylesheets/stars.css">
    <link rel="stylesheet" href="/stylesheets/styles.css">
    <!-- Per-page extras (e.g. MapLibre) -->
    <%- block('pageStyles').toString() %>
</head>
<body>
    <%- include('../partials/navbar') %>

    <!-- Toast flash container -->
    <div id="toast-container" class="toast-container" aria-live="polite"></div>

    <main><%- body %></main>

    <%- include('../partials/footer') %>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bs-custom-file-input/dist/bs-custom-file-input.min.js"></script>
    <script src="/javascripts/validateForms.js"></script>
    <script src="/javascripts/animations.js"></script>
    <!-- Per-page scripts (e.g. Flatpickr, FullCalendar) -->
    <%- block('pageScripts').toString() %>

    <!-- Flash data → JS toasts -->
    <script>
    (function() {
        <% if(success && success.length) { %>
        window.__flash = { type: 'success', msg: `<%= success %>` };
        <% } else if(error && error.length) { %>
        window.__flash = { type: 'error', msg: `<%= error %>` };
        <% } %>
    })();
    </script>
</body>
</html>
