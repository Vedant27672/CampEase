<% layout('layouts/boilerplate') %>

<!-- ═══ HERO ═══════════════════════════════════════════════════ -->
<section class="hero">
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <div class="hero-badge reveal-up"><i class="fas fa-star"></i>&nbsp; Trusted by outdoor explorers</div>
        <h1 class="hero-h1 reveal-up" style="animation-delay:.1s">
            Find Your Next<br><span class="hero-gradient">Wild Escape</span>
        </h1>
        <p class="hero-sub reveal-up" style="animation-delay:.2s">
            Discover handpicked campgrounds, read honest reviews from real campers,<br class="d-none d-lg-block">
            and share your own adventures with a passionate outdoor community.
        </p>
        <div class="hero-btns reveal-up" style="animation-delay:.3s">
            <a href="/campgrounds" class="btn-fill-lg">
                <i class="fas fa-compass"></i> Explore Campgrounds
            </a>
            <% if(!currentUser) { %>
            <a href="/register" class="btn-ghost-lg">Join for Free &rarr;</a>
            <% } else { %>
            <a href="/campgrounds/new" class="btn-ghost-lg"><i class="fas fa-plus-circle"></i> Add a Camp &rarr;</a>
            <% } %>
        </div>
    </div>
    <!-- Scroll indicator -->
    <div class="hero-scroll-indicator">
        <div class="scroll-dot"></div>
    </div>
</section>

<!-- ═══ STATS STRIP ══════════════════════════════════════════ -->
<div class="stats-strip">
    <div class="stat-item">
        <span class="stat-num" data-target="<%= stats.campgrounds %>">0</span>
        <span class="stat-label">Campgrounds</span>
    </div>
    <div class="stat-divider"></div>
    <div class="stat-item">
        <span class="stat-num" data-target="<%= stats.reviews %>">0</span>
        <span class="stat-label">Reviews</span>
    </div>
    <div class="stat-divider"></div>
    <div class="stat-item">
        <span class="stat-num" data-target="<%= stats.campers %>">0</span>
        <span class="stat-label">Campers</span>
    </div>
    <div class="stat-divider"></div>
    <div class="stat-item">
        <span class="stat-num" data-target="<%= stats.locations %>">0</span>
        <span class="stat-label">Locations</span>
    </div>
</div>

<!-- ═══ FEATURES ════════════════════════════════════════════ -->
<section class="features-section">
    <div class="section-container">
        <div class="section-header scroll-reveal">
            <span class="section-tag">Why CampEase</span>
            <h2 class="section-h2">Everything you need for the perfect trip</h2>
            <p class="section-sub">Plan smarter, camp better — all in one place.</p>
        </div>

        <div class="features-grid">
            <div class="feature-card scroll-reveal" style="--i:0">
                <div class="feature-icon-wrap">
                    <i class="fas fa-campground"></i>
                </div>
                <h3>Discover Camps</h3>
                <p>Thousands of verified campgrounds with photos, ratings, and detailed info from real campers.</p>
            </div>
            <div class="feature-card scroll-reveal" style="--i:1">
                <div class="feature-icon-wrap">
                    <i class="fas fa-star"></i>
                </div>
                <h3>Honest Reviews</h3>
                <p>Rate and review your stays to help the community find the best spots and avoid surprises.</p>
            </div>
            <div class="feature-card scroll-reveal" style="--i:2">
                <div class="feature-icon-wrap">
                    <i class="fas fa-images"></i>
                </div>
                <h3>Photo Galleries</h3>
                <p>Upload and browse beautiful campground photos to get a real feel before you pack your bags.</p>
            </div>
            <div class="feature-card scroll-reveal" style="--i:3">
                <div class="feature-icon-wrap">
                    <i class="fas fa-map-marked-alt"></i>
                </div>
                <h3>Interactive Maps</h3>
                <p>View every campground on a live outdoor map — zoom out to see all camps across the region.</p>
            </div>
            <div class="feature-card scroll-reveal" style="--i:4">
                <div class="feature-icon-wrap">
                    <i class="fas fa-dollar-sign"></i>
                </div>
                <h3>Clear Pricing</h3>
                <p>No surprises — see exactly what you'll pay per night before making any decisions.</p>
            </div>
            <div class="feature-card scroll-reveal" style="--i:5">
                <div class="feature-icon-wrap">
                    <i class="fas fa-users"></i>
                </div>
                <h3>Community Driven</h3>
                <p>Join explorers who share tips, stories, and recommendations for the best outdoor adventures.</p>
            </div>
        </div>
    </div>
</section>

<!-- ═══ CTA BANNER ═══════════════════════════════════════════ -->
<section class="cta-banner scroll-reveal">
    <div class="cta-inner">
        <div class="cta-text">
            <h2>Ready for your next adventure?</h2>
            <p>Join <%= stats.campers %> campers who use CampEase to plan unforgettable outdoor experiences.</p>
        </div>
        <div class="cta-btns">
            <% if(!currentUser) { %>
            <a href="/register" class="btn-fill-lg">Create Free Account</a>
            <% } else { %>
            <a href="/bookings" class="btn-fill-lg"><i class="fas fa-calendar-check"></i> My Bookings</a>
            <% } %>
            <a href="/campgrounds" class="btn-ghost-lg btn-ghost-light">Browse Campgrounds</a>
        </div>
    </div>
</section>
